# Copie este arquivo para `.env.local` e preencha com a sua chave.
# `.env.local` está no .gitignore — nunca comite.

# Resend (https://resend.com/api-keys)
# Crie a conta com o e-mail que você quer receber as mensagens
# (enquanto estiver usando o sender `onboarding@resend.dev`, só esse endereço
# vai receber os e-mails — pra liberar qualquer destinatário, verifique um
# domínio próprio em https://resend.com/domains).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
